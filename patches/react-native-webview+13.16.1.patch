@@ -0,0 +1,27 @@
+package com.reactnativecommunity.webview;
+
+import android.webkit.WebView;
+
+import androidx.annotation.Nullable;
+
+/**
+ * Point d'extension ajouté par Actunime (patch-package) : permet à un module externe de bloquer des
+ * sous-ressources (publicités, pisteurs) et de préparer chaque WebView (script de début de document),
+ * ce que react-native-webview n'expose pas.
+ */
+public final class RequestFilter {
+    public interface Delegate {
+        /** Appelé sur les threads réseau de la WebView : doit être rapide et thread-safe. */
+        boolean shouldBlock(String url, String pageUrl, @Nullable String accept, boolean isMainFrame);
+
+        /** Appelé une fois par WebView, à sa création (thread principal). */
+        void onWebViewCreated(WebView view);
+
+        /** Appelé au début de chaque navigation (thread principal). */
+        void onPageStarted(WebView view, String url);
+    }
+
+    @Nullable public static volatile Delegate delegate;
+
+    private RequestFilter() {}
+}
